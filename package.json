  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "knowledge:sync": "node scripts/sync-vodafone-knowledge.mjs",
    "docs:validate": "node --experimental-strip-types scripts/validate-docs.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --project tsconfig.typecheck.json --pretty false",
    "test:docs": "node --experimental-strip-types --test scripts/docs-portal.test.mjs",
    "test:chat-contract": "node --experimental-strip-types --test scripts/chat-contract-v1.test.mjs scripts/conversation-orchestrator.test.mjs scripts/demo-scenario-flow.test.mjs scripts/router-diagnostics.test.mjs scripts/tariff-comparison.test.mjs scripts/rag-response-plan.test.mjs scripts/smart-demo-conversation.test.mjs scripts/mock-operator.test.mjs scripts/tobi-config.test.mjs scripts/tobi-config-sync.test.mjs scripts/carousel-layout.test.mjs",
    "test:e2e-config": "node --experimental-strip-types --test --test-isolation=none scripts/playwright-config.test.mjs",
    "test:tariff-e2e": "playwright test e2e/tariff-comparison.spec.ts",
    "test:release-gate": "node --test scripts/staging-release-gate.test.mjs",
    "release:validate": "node scripts/validate-staging-release.mjs",
    "db:generate": "drizzle-kit generate",
    "test:postgres-tls": "node --experimental-strip-types --test --test-isolation=none scripts/tobi-postgres-tls.test.mjs",
    "test:migration": "node --experimental-strip-types --test --test-isolation=none scripts/vercel-migration.test.mjs scripts/tobi-postgres.test.mjs",
