# Server-only transaction pooler URL; TLS certificate verification required.
DATABASE_URL=
# Optional server-only PEM CA certificate text (not a path); real newlines.
# Explicit empty DATABASE_CA_CERT is invalid; leave unset for default system trust.
# DATABASE_CA_CERT=
# Optional server-side model access. Never use NEXT_PUBLIC for secrets.
OPENAI_API_KEY=
# Local dev/test only; ignored in production. Empty disables memory storage.
TOBI_IN_MEMORY_CONFIG=
TOBI_ROUTER_VISION_MODEL=
TOBI_ROUTER_VISION_FIXTURES_ENABLED=
# Playwright only: isolated loopback port, integer 1..65535 (default 15173).
# Export in the shell when overriding; Playwright does not load this file.
TOBI_E2E_PORT=15173

# Supabase Auth: HTTPS project URL and NEW public sb_publishable_ key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only UUID allowlist of EXISTING Auth Users; comma/whitespace separated.
TOBI_ADMIN_USER_IDS=
